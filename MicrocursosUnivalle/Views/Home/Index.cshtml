@model IEnumerable<MicrocursosUnivalle.Models.Curso>
@{
    ViewData["Title"] = "Catálogo de Cursos";
}

<!-- HERO -->
<section class="hero-guindo">
    <div class="container">
        <h1><i class="fas fa-graduation-cap me-3"></i>Microcursos Univalle</h1>
        <p class="mt-3">Aprende a tu ritmo con nuestros microcursos técnicos y tutoriales especializados</p>
        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <div class="mt-4">
                <a asp-controller="Cuenta" asp-action="Registrar" class="btn btn-dorado btn-lg me-3">
                    <i class="fas fa-user-plus me-2"></i>Registrarse gratis
                </a>
                <a asp-controller="Cuenta" asp-action="Ingresar" class="btn btn-outline-light btn-lg">
                    <i class="fas fa-sign-in-alt me-2"></i>Ingresar
                </a>
            </div>
        }
    </div>
</section>

<!-- CATÁLOGO -->
<section class="py-5">
    <div class="container">
        <h2 class="seccion-titulo">
            <i class="fas fa-book me-2"></i>Cursos Disponibles
        </h2>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-book-open" style="font-size: 4rem; color: var(--gris-medio);"></i>
                <h4 class="mt-3" style="color: var(--texto-medio);">Próximamente habrá cursos disponibles</h4>
                <p class="text-muted">Estamos preparando contenido de calidad para ti.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var curso in Model)
                {
                    <div class="col">
                        <div class="tarjeta-curso card h-100">
                            <div class="card-header">
                                <h5>@curso.Titulo</h5>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-muted">
                                    @(curso.Descripcion.Length > 120 ? curso.Descripcion.Substring(0, 120) + "..." : curso.Descripcion)
                                </p>
                                <div class="d-flex gap-2 mt-3 flex-wrap">
                                    <span class="badge-nivel badge-@curso.Nivel.ToLower()">
                                        <i class="fas fa-signal me-1"></i>@curso.Nivel
                                    </span>
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-clock me-1"></i>@curso.DuracionHoras h
                                    </span>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a asp-controller="Home" asp-action="Detalle" asp-route-id="@curso.Id"
                                   class="btn btn-guindo btn-sm w-100">
                                    <i class="fas fa-eye me-2"></i>Ver curso
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
