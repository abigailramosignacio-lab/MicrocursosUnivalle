@model MicrocursosUnivalle.Models.Curso
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:var(--guindo-medio)">Inicio</a></li>
            <li class="breadcrumb-item active">@Model.Titulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Info del curso -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header" style="background: linear-gradient(135deg, var(--guindo-oscuro), var(--guindo-medio)); border-bottom: 3px solid var(--dorado);">
                    <h2 class="mb-0" style="color: var(--dorado-claro); font-weight: 700;">@Model.Titulo</h2>
                </div>
                <div class="card-body p-4">
                    <p class="lead">@Model.Descripcion</p>

                    <hr />
                    <h5 class="seccion-titulo">Contenido del curso</h5>
                    @if (Model.Lecciones.Any())
                    {
                        <div class="list-group">
                            @foreach (var leccion in Model.Lecciones.OrderBy(l => l.Orden))
                            {
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fas fa-lock text-muted me-2"></i>
                                        <strong>@leccion.Orden.</strong> @leccion.Titulo
                                    </span>
                                    <span class="badge bg-secondary">@leccion.DuracionMinutos min</span>
                                </div>
                            }
                        </div>
                        <p class="text-muted mt-3 small">
                            <i class="fas fa-info-circle me-1"></i>
                            Inscríbete para acceder al contenido completo de las lecciones.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted"><i class="fas fa-info-circle me-1"></i>Este curso aún no tiene lecciones disponibles.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Panel lateral -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="fas fa-book-open" style="font-size: 3rem; color: var(--guindo-medio);"></i>
                    </div>
                    <div class="d-flex justify-content-center gap-3 mb-4 flex-wrap">
                        <span class="badge-nivel badge-@Model.Nivel.ToLower()">
                            <i class="fas fa-signal me-1"></i>@Model.Nivel
                        </span>
                        <span class="badge bg-secondary p-2">
                            <i class="fas fa-clock me-1"></i>@Model.DuracionHoras horas
                        </span>
                        <span class="badge bg-info text-dark p-2">
                            <i class="fas fa-list me-1"></i>@Model.Lecciones.Count lecciones
                        </span>
                    </div>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Suscriptor"))
                        {
                            <form asp-controller="Inscripciones" asp-action="Inscribir" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idCurso" value="@Model.Id" />
                                <button type="submit" class="btn btn-guindo btn-lg w-100">
                                    <i class="fas fa-plus-circle me-2"></i>Inscribirse gratis
                                </button>
                            </form>
                            <div class="mt-2">
                                <a asp-controller="Inscripciones" asp-action="VerCurso" asp-route-id="@Model.Id"
                                   class="btn btn-outline-guindo btn-sm w-100">
                                    <i class="fas fa-play me-1"></i>Ir a mis lecciones
                                </a>
                            </div>
                        }
                        else if (User.IsInRole("Administrador"))
                        {
                            <a asp-controller="Cursos" asp-action="Detalles" asp-route-id="@Model.Id"
                               class="btn btn-guindo btn-lg w-100">
                                <i class="fas fa-cog me-2"></i>Administrar curso
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="Registrar" class="btn btn-guindo btn-lg w-100">
                            <i class="fas fa-user-plus me-2"></i>Regístrate para inscribirte
                        </a>
                        <p class="text-muted mt-2 small">¿Ya tienes cuenta?
                            <a asp-controller="Cuenta" asp-action="Ingresar" style="color: var(--guindo-medio);">Ingresa aquí</a>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
