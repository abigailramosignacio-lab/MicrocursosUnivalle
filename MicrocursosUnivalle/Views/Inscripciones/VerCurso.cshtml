@model MicrocursosUnivalle.ModelosVista.DetalleCursoVM
@{
    ViewData["Title"] = Model.Curso.Titulo;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MisCursos" style="color:var(--guindo-medio)">Mis Cursos</a></li>
            <li class="breadcrumb-item active">@Model.Curso.Titulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Lecciones -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3" style="background: linear-gradient(135deg, var(--guindo-oscuro), var(--guindo-medio)); border-bottom: 3px solid var(--dorado);">
                    <h4 class="mb-0" style="color: var(--dorado-claro);">
                        <i class="fas fa-list me-2"></i>@Model.Curso.Titulo
                    </h4>
                </div>
                <div class="card-body p-3">
                    @if (!Model.Lecciones.Any())
                    {
                        <p class="text-muted p-3"><i class="fas fa-info-circle me-1"></i>Este curso no tiene lecciones todavía.</p>
                    }
                    else
                    {
                        @foreach (var leccion in Model.Lecciones)
                        {
                            bool completada = Model.LeccionesCompletadasIds.Contains(leccion.Id);
                            <div class="leccion-item @(completada ? "completada" : "") d-flex justify-content-between align-items-center">
                                <div>
                                    @if (completada)
                                    {
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-play-circle me-2" style="color: var(--guindo-medio);"></i>
                                    }
                                    <strong>@leccion.Orden.</strong> @leccion.Titulo
                                    <span class="text-muted small ms-2"><i class="fas fa-clock me-1"></i>@leccion.DuracionMinutos min</span>
                                </div>
                                <a asp-action="VerLeccion" asp-route-idLeccion="@leccion.Id"
                                   class="btn btn-sm @(completada ? "btn-outline-success" : "btn-guindo")">
                                    @(completada ? "Repasar" : "Ver lección")
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Panel de progreso -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 text-center">
                    <h5 class="seccion-titulo">Mi progreso</h5>
                    @{
                        int total = Model.Lecciones.Count;
                        int completadas = Model.LeccionesCompletadasIds.Count;
                        double porcentaje = total == 0 ? 0 : Math.Round((double)completadas / total * 100, 1);
                    }
                    <div class="card-estadistica mb-3">
                        <div class="numero" style="color: var(--guindo-medio);">@porcentaje%</div>
                        <div class="etiqueta">Completado</div>
                    </div>
                    <div class="progress progreso-guindo mb-3" style="height: 12px;">
                        <div class="progress-bar" role="progressbar" style="width: @porcentaje%"
                             aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="text-muted small">@completadas de @total lecciones completadas</p>
                    <a asp-action="MiProgreso" asp-route-idCurso="@Model.Curso.Id" class="btn btn-outline-guindo btn-sm w-100">
                        <i class="fas fa-chart-bar me-2"></i>Ver progreso detallado
                    </a>
                </div>
            </div>
            <div class="mt-3">
                <a asp-action="MisCursos" class="btn btn-outline-guindo btn-sm w-100">
                    <i class="fas fa-arrow-left me-2"></i>Mis cursos
                </a>
            </div>
        </div>
    </div>
</div>
