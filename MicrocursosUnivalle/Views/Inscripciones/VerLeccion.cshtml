@model MicrocursosUnivalle.Models.Leccion
@{
    ViewData["Title"] = Model.Titulo;
    var inscripcion = ViewBag.Inscripcion as MicrocursosUnivalle.Models.Inscripcion;
    bool yaCompletada = ViewBag.YaCompletada;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MisCursos" style="color:var(--guindo-medio)">Mis Cursos</a></li>
            <li class="breadcrumb-item">
                <a asp-action="VerCurso" asp-route-id="@Model.CursoId" style="color:var(--guindo-medio)">
                    @Model.Curso?.Titulo
                </a>
            </li>
            <li class="breadcrumb-item active">@Model.Titulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Contenido de la lección -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3" style="background: linear-gradient(135deg, var(--guindo-oscuro), var(--guindo-medio)); border-bottom: 3px solid var(--dorado);">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0" style="color: var(--dorado-claro);">
                            <span class="badge me-2" style="background: rgba(255,255,255,0.2);">@Model.Orden</span>
                            @Model.Titulo
                        </h4>
                        <span class="badge bg-light text-dark">
                            <i class="fas fa-clock me-1"></i>@Model.DuracionMinutos min
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="contenido-leccion">
                        @Html.Raw(Model.Contenido)
                    </div>
                </div>
                <div class="card-footer p-3">
                    @if (!yaCompletada)
                    {
                        <form asp-action="MarcarCompletada" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idInscripcion" value="@inscripcion?.Id" />
                            <input type="hidden" name="idLeccion" value="@Model.Id" />
                            <button type="submit" class="btn btn-guindo">
                                <i class="fas fa-check-circle me-2"></i>Marcar como completada
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-success fw-bold">
                                <i class="fas fa-check-circle me-2"></i>Lección completada
                            </span>
                            <a asp-action="VerCurso" asp-route-id="@Model.CursoId" class="btn btn-outline-guindo btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Volver al curso
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Panel lateral -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <h6 class="seccion-titulo">Curso</h6>
                    <p class="fw-bold" style="color: var(--guindo-medio);">@Model.Curso?.Titulo</p>
                    <a asp-action="VerCurso" asp-route-id="@Model.CursoId" class="btn btn-outline-guindo btn-sm w-100">
                        <i class="fas fa-list me-1"></i>Ver todas las lecciones
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
