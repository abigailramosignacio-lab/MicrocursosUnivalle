@model IEnumerable<MicrocursosUnivalle.Models.Curso>
@{
    ViewData["Title"] = "Gestión de Cursos";
}

<div class="container py-4">
    <div class="panel-admin d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-cogs me-2"></i>Gestión de Cursos</h2>
            <p class="mb-0" style="opacity: 0.8;">Administra todos los cursos del portal</p>
        </div>
        <a asp-action="Crear" class="btn btn-dorado">
            <i class="fas fa-plus me-2"></i>Nuevo Curso
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-folder-open" style="font-size: 4rem; color: var(--gris-medio);"></i>
            <h5 class="mt-3 text-muted">No hay cursos creados aún</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tabla-guindo table-hover align-middle">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Nivel</th>
                        <th>Duración</th>
                        <th>Lecciones</th>
                        <th>Inscritos</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var curso in Model)
                    {
                        <tr>
                            <td><strong>@curso.Titulo</strong></td>
                            <td>
                                <span class="badge-nivel badge-@curso.Nivel.ToLower()">@curso.Nivel</span>
                            </td>
                            <td><i class="fas fa-clock me-1 text-muted"></i>@curso.DuracionHoras h</td>
                            <td><i class="fas fa-list me-1 text-muted"></i>@curso.Lecciones.Count</td>
                            <td><i class="fas fa-users me-1 text-muted"></i>@curso.Inscripciones.Count</td>
                            <td>
                                @if (curso.Publicado)
                                {
                                    <span class="badge-publicado"><i class="fas fa-eye me-1"></i>Publicado</span>
                                }
                                else
                                {
                                    <span class="badge-no-publicado"><i class="fas fa-eye-slash me-1"></i>Borrador</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Editar" asp-route-id="@curso.Id" class="btn btn-outline-secondary" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="Lecciones" asp-action="Index" asp-route-cursoId="@curso.Id"
                                       class="btn btn-outline-primary" title="Lecciones">
                                        <i class="fas fa-list"></i>
                                    </a>
                                    <a asp-action="Suscriptores" asp-route-id="@curso.Id"
                                       class="btn btn-outline-info" title="Ver inscritos">
                                        <i class="fas fa-users"></i>
                                    </a>
                                    <form asp-action="CambiarPublicacion" asp-route-id="@curso.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(curso.Publicado ? "btn-outline-warning" : "btn-outline-success")" title="@(curso.Publicado ? "Despublicar" : "Publicar")">
                                            <i class="fas @(curso.Publicado ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Eliminar" asp-route-id="@curso.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
