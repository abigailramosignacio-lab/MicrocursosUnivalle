@model MicrocursosUnivalle.Models.Curso
@{
    ViewData["Title"] = "Detalles del Curso";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" style="color:var(--guindo-medio)">Cursos</a></li>
            <li class="breadcrumb-item active">@Model.Titulo</li>
        </ol>
    </nav>

    <div class="panel-admin d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3><i class="fas fa-book me-2"></i>@Model.Titulo</h3>
            <div class="d-flex gap-2 flex-wrap mt-1">
                <span class="badge-nivel badge-@Model.Nivel.ToLower()">@Model.Nivel</span>
                <span class="badge bg-light text-dark"><i class="fas fa-clock me-1"></i>@Model.DuracionHoras horas</span>
                @if (Model.Publicado)
                {
                    <span class="badge-publicado"><i class="fas fa-eye me-1"></i>Publicado</span>
                }
                else
                {
                    <span class="badge-no-publicado"><i class="fas fa-eye-slash me-1"></i>Borrador</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-dorado btn-sm">
                <i class="fas fa-edit me-1"></i>Editar
            </a>
            <a asp-controller="Lecciones" asp-action="Index" asp-route-cursoId="@Model.Id" class="btn btn-outline-light btn-sm">
                <i class="fas fa-list me-1"></i>Lecciones
            </a>
        </div>
    </div>

    <div class="row mt-4 g-4">
        <!-- Lecciones -->
        <div class="col-lg-7">
            <h5 class="seccion-titulo"><i class="fas fa-list me-2"></i>Lecciones (@Model.Lecciones.Count)</h5>
            @if (Model.Lecciones.Any())
            {
                @foreach (var leccion in Model.Lecciones.OrderBy(l => l.Orden))
                {
                    <div class="leccion-item d-flex justify-content-between align-items-center">
                        <span>
                            <span class="badge" style="background: var(--guindo-medio); color:white; margin-right:8px;">@leccion.Orden</span>
                            @leccion.Titulo
                        </span>
                        <span class="text-muted small"><i class="fas fa-clock me-1"></i>@leccion.DuracionMinutos min</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted"><i class="fas fa-info-circle me-1"></i>No hay lecciones. <a asp-controller="Lecciones" asp-action="Crear" asp-route-cursoId="@Model.Id" style="color:var(--guindo-medio)">Agregar primera lección</a></p>
            }
        </div>

        <!-- Suscriptores -->
        <div class="col-lg-5">
            <h5 class="seccion-titulo"><i class="fas fa-users me-2"></i>Inscritos (@Model.Inscripciones.Count)</h5>
            @if (Model.Inscripciones.Any())
            {
                <div class="list-group">
                    @foreach (var inscripcion in Model.Inscripciones.OrderByDescending(i => i.FechaInscripcion))
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-user-circle me-2" style="color:var(--guindo-medio)"></i>@inscripcion.Usuario?.Email</span>
                            <span class="text-muted small">@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted"><i class="fas fa-info-circle me-1"></i>Aún no hay inscritos en este curso.</p>
            }
        </div>
    </div>
</div>
