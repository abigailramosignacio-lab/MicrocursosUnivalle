@model MicrocursosUnivalle.Models.Curso
@{
    ViewData["Title"] = "Nuevo Curso";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" style="color:var(--guindo-medio)">Cursos</a></li>
            <li class="breadcrumb-item active">Nuevo Curso</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-header py-3" style="background: linear-gradient(135deg, var(--guindo-oscuro), var(--guindo-medio)); border-bottom: 3px solid var(--dorado);">
                    <h4 class="mb-0" style="color: var(--dorado-claro);">
                        <i class="fas fa-plus-circle me-2"></i>Crear Nuevo Curso
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Título del curso" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Descripción del curso..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nivel" class="form-label"></label>
                                <select asp-for="Nivel" class="form-select">
                                    <option value="">-- Seleccionar nivel --</option>
                                    <option value="Básico">Básico</option>
                                    <option value="Intermedio">Intermedio</option>
                                    <option value="Avanzado">Avanzado</option>
                                </select>
                                <span asp-validation-for="Nivel" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DuracionHoras" class="form-label"></label>
                                <input asp-for="DuracionHoras" class="form-control" type="number" min="1" placeholder="Ej: 10" />
                                <span asp-validation-for="DuracionHoras" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label asp-for="ImagenUrl" class="form-label"></label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="Publicado" class="form-check-input" />
                            <label asp-for="Publicado" class="form-check-label">Publicar curso inmediatamente</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-guindo px-4">
                                <i class="fas fa-save me-2"></i>Guardar Curso
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
