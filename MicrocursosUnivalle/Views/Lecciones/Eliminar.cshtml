@model MicrocursosUnivalle.Models.Leccion
@{
    ViewData["Title"] = "Eliminar Lección";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow border-danger">
                <div class="card-header py-3" style="background: #dc3545; color: white;">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="lead">¿Deseas eliminar esta lección?</p>
                    <div class="alert alert-guindo">
                        <h5><i class="fas fa-file-alt me-2"></i>@Model.Titulo</h5>
                        <ul class="mb-0 mt-2">
                            <li><strong>Orden:</strong> @Model.Orden</li>
                            <li><strong>Duración:</strong> @Model.DuracionMinutos minutos</li>
                            <li><strong>Curso:</strong> @Model.Curso?.Titulo</li>
                        </ul>
                    </div>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Se eliminarán también los registros de completado de esta lección.
                    </div>
                    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash me-2"></i>Sí, eliminar
                            </button>
                            <a asp-action="Index" asp-route-cursoId="@Model.CursoId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
