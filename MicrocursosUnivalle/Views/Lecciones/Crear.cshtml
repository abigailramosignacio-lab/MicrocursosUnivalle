@model MicrocursosUnivalle.Models.Leccion
@{
    ViewData["Title"] = "Nueva Lección";
    var curso = ViewBag.Curso as MicrocursosUnivalle.Models.Curso;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Cursos" asp-action="Index" style="color:var(--guindo-medio)">Cursos</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-cursoId="@curso?.Id" style="color:var(--guindo-medio)">Lecciones</a></li>
            <li class="breadcrumb-item active">Nueva Lección</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-header py-3" style="background: linear-gradient(135deg, var(--guindo-oscuro), var(--guindo-medio)); border-bottom: 3px solid var(--dorado);">
                    <h4 class="mb-0" style="color: var(--dorado-claro);">
                        <i class="fas fa-plus-circle me-2"></i>Nueva Lección — @curso?.Titulo
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="CursoId" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Título de la lección" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Orden" class="form-label"></label>
                                <input asp-for="Orden" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Orden" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DuracionMinutos" class="form-label"></label>
                                <input asp-for="DuracionMinutos" class="form-control" type="number" min="1" />
                                <span asp-validation-for="DuracionMinutos" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Contenido" class="form-label"></label>
                            <textarea asp-for="Contenido" class="form-control" rows="10"
                                      placeholder="Puedes escribir texto o HTML del contenido de la lección..."></textarea>
                            <span asp-validation-for="Contenido" class="text-danger small"></span>
                            <div class="form-text">Puedes usar HTML básico para formatear el contenido.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-guindo px-4">
                                <i class="fas fa-save me-2"></i>Guardar Lección
                            </button>
                            <a asp-action="Index" asp-route-cursoId="@Model.CursoId" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
